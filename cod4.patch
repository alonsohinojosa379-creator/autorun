diff --git a/horizon-wine/games/cod4.conf b/horizon-wine/games/cod4.conf
new file mode 100644
index 0000000..429b81d
--- /dev/null
+++ b/horizon-wine/games/cod4.conf
@@ -0,0 +1,19 @@
+# Call of Duty 4: Modern Warfare (1.7, campaign iw3sp.exe): 32-bit x86, Direct3D 9
+# through DXVK, WoW64 + FEX. Read by build-game.sh.
+ROOT_NAME=cod4
+APP_NAME="Call of Duty 4: Modern Warfare"
+APP_AUTHOR="Port de Asce22"
+APP_ICON=horizon-wine/assets/cod4.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Call of Duty 4: Modern Warfare para Nintendo Switch||Port Hecho por Asce22"
+# Copy the whole installed game folder (iw3sp.exe, main, zone, miles, ...) to
+# switch/cod4/drive_c/COD4. No d3d9.dll of the game's own may stay in that
+# folder, or it is used instead of Autorun's DXVK.
+EXE="COD4/iw3sp.exe"
+# Windowed 960x540, intro off, single-threaded renderer (less work for FEX).
+# To change them without rebuilding, put the line in
+# drive_c/COD4/COD4.args.txt.
+ARGS="+set r_fullscreen 0 +set r_mode 800x600 +set intro 0 +set sys_smp_allowed 0 +set r_multigpu 0"
+# Files copied onto the card as they are, under switch/cod4: DXVK and FEX
+# with TSO, capped at 30 fps (COD4.wine-nx.txt).
+FILES=horizon-wine/games/cod4
diff --git a/horizon-wine/games/cod4/drive_c/COD4/COD4.wine-nx.txt b/horizon-wine/games/cod4/drive_c/COD4/COD4.wine-nx.txt
new file mode 100644
index 0000000..5059be0
--- /dev/null
+++ b/horizon-wine/games/cod4/drive_c/COD4/COD4.wine-nx.txt
@@ -0,0 +1,4 @@
+cpu=fex
+d3d=dxvk
+FEX_TSOENABLED=1
+frame-limit=30
-- 
2.43.0

