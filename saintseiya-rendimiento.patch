+static void *cache_worker(void *argument)
+{
+    unsigned int seed = (uintptr_t)argument + 17;
+    unsigned char *items[48] = {0};
+    size_t sizes[48] = {0};
+    for (unsigned int iteration = 0; iteration < 60000; iteration++)
