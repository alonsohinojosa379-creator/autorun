+static void cache_resize_and_pressure(void)
+{
+    wine_nx_shader_alloc_begin();
+    unsigned char *a = __wrap__malloc_r(_REENT, 128);
+    unsigned char *b = __wrap__malloc_r(_REENT, 4096);
+    assert(a && b);
