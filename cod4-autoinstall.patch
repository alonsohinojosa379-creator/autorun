From c36c6a894ac8969f75fb4c5e066d35c0bb001db7 Mon Sep 17 00:00:00 2001
From: b <b@l>
Date: Sun, 4 Oct 2026 11:32:36 -0600
Subject: [PATCH] Single-game builds: offer to install the low-address
 Atmosphere patch from the game itself

When a game needs the low-address window and the console is not running the
patched kernel, instead of stopping, offer to install the bundled Mesosphere
and loader and add the Autorun Hekate entry (same payloads as Quick setup).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016vCWYFeSt88D5G1QzjUVsH
---
 horizon-wine/source/runtime.c | 148 ++++++++++++++++++++++++++++++++++
 1 file changed, 148 insertions(+)

diff --git a/horizon-wine/source/runtime.c b/horizon-wine/source/runtime.c
index 7060da3..6ba0a29 100644
--- a/horizon-wine/source/runtime.c
+++ b/horizon-wine/source/runtime.c
@@ -30,6 +30,7 @@
 #include "forwarder_launch.h"
 #include "launcher_catalog.h"
 #include "launcher_list.h"
+#include "setup_boot.h"
 #include "launcher_settings.h"
 #include "fex_options.h"
 #include "config_json.h"
@@ -3810,6 +3811,150 @@ static int fixed_target_stop( const char *why )
     return 0;
 }
 
+/* Waits for one of the buttons in mask; returns the one pressed, or 0 if the
+ * applet is closing. */
+static u64 fixed_target_wait( PadState *pad, u64 mask )
+{
+    while (appletMainLoop())
+    {
+        u64 down;
+        padUpdate( pad );
+        down = padGetButtonsDown( pad ) & mask;
+        if (down) return down;
+        consoleUpdate( NULL );
+        svcSleepThread( 16000000 );
+    }
+    return 0;
+}
+
+/* The game needs the low-address Atmosphere patch and it is not running. The
+ * runtime carries the same boot payloads Quick setup installs, so offer to put
+ * them on the card here: the Mesosphere and loader files, and a Hekate entry
+ * named "Autorun" that boots with them. Returns 0 if it could not even offer
+ * (no payloads in this build), so the caller shows the plain message. */
+static int fixed_target_patch_installer( void )
+{
+    const struct setup_boot_manifest *manifest = setup_boot_bundled_manifest();
+    struct setup_boot_entry *entries;
+    struct setup_boot_options options;
+    size_t count = 0, i;
+    int romfs_ok, have_autorun = 0, pick = -1, supported = 0;
+    char detail[512] = "";
+    enum setup_boot_result status;
+    PadState pad;
+    u64 version = 0, button;
+    int known;
+
+    if (!manifest) return 0;
+    entries = calloc( SETUP_BOOT_MAX_ENTRIES, sizeof(*entries) );
+    if (!entries) return 0;
+    romfs_ok = R_SUCCEEDED( romfsInit() );
+    if (!romfs_ok) { free( entries ); return 0; }
+
+    wine_nx_console_quiet = 0;
+    padConfigureInput( 1, HidNpadStyleSet_NpadStandard );
+    padInitializeDefault( &pad );
+    log_line( "[FIXED] low-address patch missing; offering the installer" );
+
+    status = setup_boot_recover( "sdmc:", detail, sizeof(detail) );
+    if (status != SETUP_BOOT_OK && status != SETUP_BOOT_ALREADY)
+    {
+        printf( "\n  %s\n\n  No se puede tocar la configuracion de arranque:\n  %s\n\n  Pulsa + para salir.\n",
+                WINE_NX_APP_NAME, detail[0] ? detail : setup_boot_error( status ) );
+        fixed_target_wait( &pad, HidNpadButton_Plus );
+        goto done;
+    }
+    status = setup_boot_list( "sdmc:", entries, SETUP_BOOT_MAX_ENTRIES, &count, detail, sizeof(detail) );
+    if (status != SETUP_BOOT_OK)
+    {
+        printf( "\n  %s\n\n  No se pudo leer bootloader/hekate_ipl.ini:\n  %s\n\n  Pulsa + para salir.\n",
+                WINE_NX_APP_NAME, detail[0] ? detail : setup_boot_error( status ) );
+        fixed_target_wait( &pad, HidNpadButton_Plus );
+        goto done;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (!strcasecmp( entries[i].name, SETUP_BOOT_ENTRY_NAME )) have_autorun = 1;
+        else if (entries[i].supported) { supported++; if (pick < 0) pick = (int)i; }
+    }
+    if (have_autorun)
+    {
+        printf( "\n  %s\n\n  El parche ya esta instalado, pero esta consola no arranco con el.\n\n"
+                "  Apaga la consola del todo, enciendela y en Hekate\n  elige la entrada \"" SETUP_BOOT_ENTRY_NAME "\".\n\n"
+                "  Pulsa + para salir.\n", WINE_NX_APP_NAME );
+        fixed_target_wait( &pad, HidNpadButton_Plus );
+        goto done;
+    }
+    if (pick < 0)
+    {
+        printf( "\n  %s\n\n  Falta el parche de direcciones bajas y no hay una entrada de\n"
+                "  Hekate compatible (necesita fss0= o pkg3=).\n  Instalalo con el Autorun completo.\n\n"
+                "  Pulsa + para salir.\n", WINE_NX_APP_NAME );
+        fixed_target_wait( &pad, HidNpadButton_Plus );
+        goto done;
+    }
+
+    for (;;)
+    {
+        consoleClear();
+        printf( "\n  %s\n\n  Este juego necesita el parche de direcciones bajas de Atmosphere.\n"
+                "  Se instalara Mesosphere y el loader, y una entrada nueva de Hekate\n"
+                "  llamada \"" SETUP_BOOT_ENTRY_NAME "\". Tu entrada original no se toca.\n\n"
+                "  Copia de: %s%s\n  (arriba/abajo para cambiar)\n\n"
+                "  Usa emuMMC. Instalar titulos no oficiales puede causar baneo.\n\n"
+                "  A: instalar   +: salir\n", WINE_NX_APP_NAME, entries[pick].name,
+                supported > 1 ? "  <--" : "" );
+        button = fixed_target_wait( &pad, HidNpadButton_A | HidNpadButton_Plus | HidNpadButton_Up | HidNpadButton_Down );
+        if (!button || (button & HidNpadButton_Plus)) goto done;
+        if (button & (HidNpadButton_Up | HidNpadButton_Down))
+        {
+            int dir = (button & HidNpadButton_Down) ? 1 : -1, n = (int)count, j = pick;
+            for (;;)
+            {
+                j = (j + dir + n) % n;
+                if (entries[j].supported && strcasecmp( entries[j].name, SETUP_BOOT_ENTRY_NAME )) { pick = j; break; }
+                if (j == pick) break;
+            }
+            continue;
+        }
+        break;
+    }
+
+    /* The patched kernel is built for exactly one Atmosphere. */
+    splInitialize();
+    known = R_SUCCEEDED( splGetConfig( (SplConfigItem)65000, &version ) );
+    splExit();
+    if (!known || ((version >> 40) & UINT32_C(0xffffff)) != manifest->atmosphere_version)
+    {
+        printf( "\n  No se pudo confirmar que Atmosphere sea la 1.11.2.\n  Actualizala, arranca con ella y vuelve a abrir el juego.\n\n  Pulsa + para salir.\n" );
+        fixed_target_wait( &pad, HidNpadButton_Plus );
+        goto done;
+    }
+
+    memset( &options, 0, sizeof(options) );
+    options.entry = entries[pick];
+    options.loader = SETUP_BOOT_STOCK;
+    printf( "\n  Instalando...\n" );
+    consoleUpdate( NULL );
+    detail[0] = 0;
+    status = setup_boot_install( "sdmc:", "romfs:/setup", manifest, &options, detail, sizeof(detail) );
+    log_line( "[FIXED] patch install: %s %s", setup_boot_error( status ), detail );
+    if (status == SETUP_BOOT_OK || status == SETUP_BOOT_ALREADY)
+        printf( "\n  Listo.\n\n  1) Apaga la consola del todo y enciendela de nuevo.\n"
+                "  2) En Hekate elige la entrada \"" SETUP_BOOT_ENTRY_NAME "\".\n"
+                "  3) Abre el juego desde su icono de HOME.\n\n  Pulsa + para salir.\n" );
+    else
+        printf( "\n  No se pudo instalar:\n  %s\n\n  Pulsa + para salir.\n",
+                detail[0] ? detail : setup_boot_error( status ) );
+    fixed_target_wait( &pad, HidNpadButton_Plus );
+done:
+    romfsExit();
+    free( entries );
+    consoleExit( NULL );
+    leave_cleanly();
+    return 1;
+}
+
 #ifdef WINE_NX_SPLASH
 /* The build's own credits, centred on the console for a few seconds before the
  * game takes the screen; A, B or + skips them. Lines are split at '|'. */
@@ -4126,8 +4271,11 @@ int main( int argc, char **argv )
         /* What the launcher checks before it starts a game: an .exe with no
          * relocations only loads at its own address, in the low window. */
         if (launcher_program_address_space( target ) == LAUNCHER_ADDRESS_LOW && !low_window_available)
+        {
+            if (fixed_target_patch_installer()) return 0;
             return fixed_target_stop( "Este juego necesita el parche de direcciones bajas de Atmosphere.\n"
                                       "  Instalalo con Quick setup en Autorun y reinicia la consola." );
+        }
         forwarded_game = 1;
         log_line( "[FIXED] %s", target );
     }
-- 
2.43.0

