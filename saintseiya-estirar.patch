From dffc564cf21200b161c1937ff8e854c8bc4db532 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Sun, 11 Oct 2026 22:10:26 -0600
Subject: [PATCH] Saint Seiya: opcion stretch=1 para estirar la imagen a toda
 la pantalla

---
 dlls/win32u/vulkan.c                  | 14 ++++++++++++++
 horizon-wine/source/graphics_config.h |  1 +
 horizon-wine/source/runtime.c         |  7 +++++++
 3 files changed, 22 insertions(+)

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 6d9d9c28..66b9ada0 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -63,6 +63,10 @@ static pthread_mutex_t present_lock = PTHREAD_MUTEX_INITIALIZER;
  * sampling. sharpness is 0 to 1 of RCAS's range. Only the Switch runtime sets
  * them (wine_nx_upscaling_configure). */
 static int nx_upscaling_mode;
+#ifdef __SWITCH__
+/* 1: the game image is stretched over the whole screen, whatever its shape. */
+static int nx_stretch;
+#endif
 static float nx_upscaling_sharpness = 0.4f;
 
 #ifdef __SWITCH__
@@ -94,6 +98,11 @@ void wine_nx_graphics_configure( int frame_limit, int vsync )
     nx_present_mode = vsync ? VK_PRESENT_MODE_FIFO_KHR : VK_PRESENT_MODE_IMMEDIATE_KHR;
 }
 
+void wine_nx_stretch_configure( int stretch )
+{
+    nx_stretch = stretch;
+}
+
 void wine_nx_upscaling_configure( int mode, float sharpness )
 {
     nx_upscaling_mode = mode;
@@ -3510,6 +3519,11 @@ static VkResult record_compute_cmd( struct vulkan_device *device, struct swapcha
         if (!swapchain->fsr && fs_hack_is_integer() && scale >= 1.0f) scale = floorf( scale );
         width = swapchain->extents.width * scale;
         height = swapchain->extents.height * scale;
+        if (nx_stretch)
+        {
+            width = swapchain->host_extents.width;
+            height = swapchain->host_extents.height;
+        }
         if (swapchain->fsr || fs_hack_is_integer())
         {
             width = min( floorf( width + 0.5f ), swapchain->host_extents.width );
diff --git a/horizon-wine/source/graphics_config.h b/horizon-wine/source/graphics_config.h
index d7b7d7eb..4f8ec79d 100644
--- a/horizon-wine/source/graphics_config.h
+++ b/horizon-wine/source/graphics_config.h
@@ -3,5 +3,6 @@
 
 void wine_nx_graphics_configure(int frame_limit, int vsync);
 void wine_nx_upscaling_configure(int mode, float sharpness);
+void wine_nx_stretch_configure(int stretch);
 
 #endif
diff --git a/horizon-wine/source/runtime.c b/horizon-wine/source/runtime.c
index 7060da30..2e2fec6f 100644
--- a/horizon-wine/source/runtime.c
+++ b/horizon-wine/source/runtime.c
@@ -4284,6 +4284,7 @@ int main( int argc, char **argv )
 #ifdef WINE_NX_MESA_SWITCH
         wine_nx_graphics_configure( 0, 1 );
         wine_nx_upscaling_configure( 0, 0.4f );
+        wine_nx_stretch_configure( 0 );
 #endif
 #ifdef WINE_NX_LSFG
         wine_nx_lsfg_configure( 0, 1, 1 );
@@ -4309,6 +4310,12 @@ int main( int argc, char **argv )
             runtime_dxvk_hud = settings.dxvk_hud;
             wine_nx_graphics_configure( launcher_frame_limits[settings.frame_limit], settings.vsync );
             wine_nx_upscaling_configure( settings.upscaling, launcher_sharpness_values[settings.upscaling_sharpness] );
+            {
+                char stretch[16];
+
+                wine_nx_stretch_configure( launcher_kv_get( &kv, "stretch", stretch, sizeof(stretch) ) &&
+                                           (!strcmp( stretch, "1" ) || !strcasecmp( stretch, "on" )) );
+            }
 #ifdef WINE_NX_LSFG
             wine_nx_lsfg_configure( settings.lsfg_enabled, settings.lsfg_performance, settings.lsfg_flow );
 #endif
-- 
