+#!/bin/sh
+# Drop members that are not AArch64 objects from static libraries.
+#
+# switch-dev 2026.09.28.4's libvulkan.a (Mesa NVK, partly Rust) carries a
+# host-built compiler_builtins object (x86-64, ELF machine 62) next to the
+# AArch64 ones; ld then stops with "file in wrong format". The image is
+# read-only to us, so the build works on a copy: this script edits the
+# libraries in place inside the throwaway container.
+#
+#   sh drop-foreign-objects.sh AR LIB...
+set -eu
+ar="$1"; shift
+tmp="${TMPDIR:-/tmp}/drop-foreign.$$"
+mkdir -p "$tmp"
+trap 'rm -rf "$tmp"' EXIT
+for lib in "$@"; do
+    [ -f "$lib" ] || continue
+    "$ar" t "$lib" > "$tmp/members"
+    dropped=0
+    while IFS= read -r m; do
+        # e_machine is the 16-bit field at offset 18 of an ELF header; AArch64 is 183.
+        magic="$("$ar" p "$lib" "$m" | od -An -c -N4 | tr -d ' \n')"
+        [ "$magic" = '177ELF' ] || continue
+        em="$("$ar" p "$lib" "$m" | od -An -tu2 -j18 -N2 | tr -d ' \n')"
+        if [ "$em" != 183 ]; then
+            echo "drop-foreign-objects: $lib: removing $m (ELF machine $em)"
+            "$ar" d "$lib" "$m"
+            dropped=$((dropped + 1))
+        fi
+    done < "$tmp/members"
+    [ "$dropped" = 0 ] || "$ar" s "$lib"
+done
