+/* For ntdll's server, when the program asks for the context of a thread it has
+ * suspended and the thread is running 32-bit code that never calls the server
+ * (so would never hand its registers over): pause it from the kernel, and if it
+ * is inside Box64's translated code read its x86 registers from where the
+ * dynarec keeps them (x10-x17 are EAX ECX EDX EBX ESP EBP ESI EDI, x26 the
+ * flags). The thread stays paused until wine_nx_thread_thaw, as a suspended
+ * thread must. Returns 1 when frozen with registers, 0 when it could not be
+ * caught inside translated code (it is running again). Native code is never
+ * left paused: it may hold the allocator's lock. */
+int wine_nx_thread_freeze_x86( void *teb, unsigned int tid, struct wine_nx_x86_regs *out )
+{
+    struct nx_prof_thread *thread = find_wine_thread( teb, tid );
+    Handle handle, self = threadGetCurHandle();
+    uintptr_t x86 = 0;
+    ThreadContext ctx;
+    Result rc;
+    int tries, ok = 0;
+
+    if (!thread || !(handle = thread->handle) || handle == self) return 0;
+    if (thread->frozen || !&wine_nx_box64_pc_to_x86) return 0;
+    pthread_mutex_lock( &profile_mutex );
+    if (R_FAILED( svcSetThreadActivity( handle, ThreadActivity_Paused ) ))
+    {
+        pthread_mutex_unlock( &profile_mutex );
+        return 0;
+    }
+    for (tries = 0; R_FAILED( rc = svcGetThreadContext3( &ctx, handle ) ) && tries < 4; tries++)
+        svcSleepThread( 0 );
+    if (R_SUCCEEDED( rc ) && wine_nx_box64_pc_to_x86( ctx.pc.x, &x86 ) && x86 <= 0xffffffffu)
+    {
+        out->eax = (uint32_t)ctx.cpu_gprs[10].x;
+        out->ecx = (uint32_t)ctx.cpu_gprs[11].x;
+        out->edx = (uint32_t)ctx.cpu_gprs[12].x;
+        out->ebx = (uint32_t)ctx.cpu_gprs[13].x;
+        out->esp = (uint32_t)ctx.cpu_gprs[14].x;
+        out->ebp = (uint32_t)ctx.cpu_gprs[15].x;
+        out->esi = (uint32_t)ctx.cpu_gprs[16].x;
+        out->edi = (uint32_t)ctx.cpu_gprs[17].x;
+        out->eip = (uint32_t)x86;
+        out->eflags = ((uint32_t)ctx.cpu_gprs[26].x & 0xfd5) | 0x202;
+        thread->frozen = 1;
+        ok = 1;
+    }
+    if (!ok) svcSetThreadActivity( handle, ThreadActivity_Runnable );
+    pthread_mutex_unlock( &profile_mutex );
+    return ok;
+}
