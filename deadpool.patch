+                            horizon_gcfix_trace( "[GCFIX] froze thread %u in translated code eip=%08x esp=%08x",
+                                                 object->thread.tid, regs.eip, regs.esp );
+                        }
+                        horizon_server_fill_i386_context( &context, (const struct wine_nx_x86_regs *)object->frozen_regs );
+                        context.flags &= request->flags | request->native_flags | SERVER_CTX_EXEC_SPACE;
+                        found = 1;
