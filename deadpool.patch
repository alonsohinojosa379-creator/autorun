+#ifdef WINE_NX_SPLASH
+/* The build's own credits, centred on the console for a few seconds before the
+ * game takes the screen; A, B or + skips them. Lines are split at '|'. */
+static void fixed_target_credits( void )
+{
+    static const char text[] = WINE_NX_SPLASH;
+    const char *line = text;
+    int lines = 1, row, i;
+    PadState pad;
+    u64 start;
+
+    if (!text[0]) return;
+    for (i = 0; text[i]; i++) if (text[i] == '|') lines++;
+    wine_nx_console_quiet = 0;
+    consoleClear();
+    row = (45 - lines * 2) / 2;  /* the console is 80x45 */
+    while (line)
+    {
+        const char *bar = strchr( line, '|' );
+        int len = bar ? (int)(bar - line) : (int)strlen( line ), col = (80 - len) / 2;
+
+        printf( "\x1b[%d;%dH%.*s", row, col < 1 ? 1 : col + 1, len, line );
+        row += 2;
+        line = bar ? bar + 1 : NULL;
+    }
+    consoleUpdate( NULL );
+    log_line( "[FIXED] credits: %s", text );
+    padConfigureInput( 1, HidNpadStyleSet_NpadStandard );
+    padInitializeDefault( &pad );
+    start = armGetSystemTick();
+    while (appletMainLoop() && armTicksToNs( armGetSystemTick() - start ) < 3000000000ull)
+    {
+        padUpdate( &pad );
+        if (padGetButtonsDown( &pad ) & (HidNpadButton_A | HidNpadButton_B | HidNpadButton_Plus)) break;
+        consoleUpdate( NULL );
+        svcSleepThread( 16000000 );
+    }
+    consoleClear();
+    consoleUpdate( NULL );
+    wine_nx_console_quiet = 1;
+}
