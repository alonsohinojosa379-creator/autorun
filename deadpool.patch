diff --git a/horizon-wine/build-game.sh b/horizon-wine/build-game.sh
new file mode 100644
index 00000000..abbca87a
--- /dev/null
+++ b/horizon-wine/build-game.sh
@@ -0,0 +1,46 @@
+#!/bin/sh
+# A single-game edition of Autorun: one game, in its own sdmc:/switch/<folder>,
+# with its own name, icon and HOME icon, and no launcher. Each game is a
+# profile in horizon-wine/games/<game>.conf. Run from anywhere, with the same
+# options as build.sh after the game's name:
+#
+#   sh horizon-wine/build-game.sh left4dead [--clean] [--jobs N]
+#
+# The card archive is written to horizon-wine/build-autorun/<game>-card.zip.
+# Builds of different games install side by side: each has its own folder
+# and, because the HOME icon's title ID comes from that folder, its own icon.
+set -eu
+root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
+cd "$root"
+
+game="${1:-}"
+if [ -z "$game" ] || [ ! -f "horizon-wine/games/$game.conf" ]; then
+    echo "Usage: sh horizon-wine/build-game.sh GAME [build.sh options]" >&2
+    echo "Games:" $(ls horizon-wine/games/*.conf | sed 's|.*/||; s|\.conf$||') >&2
+    exit 1
+fi
+shift
+
+ROOT_NAME= APP_NAME= APP_AUTHOR= APP_ICON= EXE= ARGS= FILES= BOX64_CODE_MAX_MB= SPLASH=
+. "horizon-wine/games/$game.conf"
+for v in ROOT_NAME APP_NAME APP_ICON EXE; do
+    eval "[ -n \"\${$v}\" ]" || { echo "games/$game.conf has no $v." >&2; exit 1; }
+done
+[ -f "$APP_ICON" ] || { echo "The icon $APP_ICON is missing." >&2; exit 1; }
+
+export WINE_NX_ROOT_NAME="$ROOT_NAME"
+export WINE_NX_APP_NAME="$APP_NAME"
+export WINE_NX_APP_AUTHOR="${APP_AUTHOR:-Autorun}"
+export WINE_NX_APP_ICON="$APP_ICON"
+export WINE_NX_FIXED_TARGET="sdmc:/switch/$ROOT_NAME/drive_c/$EXE"
+export WINE_NX_FIXED_ARGS="$ARGS"
+export WINE_NX_SPLASH="$SPLASH"
+[ -n "$BOX64_CODE_MAX_MB" ] && export WINE_NX_BOX64_CODE_MAX_MB="$BOX64_CODE_MAX_MB"
+printf '==> %s: %s %s\n' "$APP_NAME" "$WINE_NX_FIXED_TARGET" "$ARGS"
+
+sh "$root/build.sh" "$@"
+
+archive="$(ls -t "$root"/horizon-wine/build-autorun/autorun-*.zip | head -n 1)"
+python3 "$root/horizon-wine/tools/package-single-game.py" --autorun "$archive" \
+    --root-name "$ROOT_NAME" ${FILES:+--extra "$root/$FILES"} \
+    --out "$root/horizon-wine/build-autorun/$game-card.zip"
