+void wine_nx_thread_thaw( void *teb, unsigned int tid )
+{
+    struct nx_prof_thread *thread = find_wine_thread( teb, tid );
+
+    if (!thread || !thread->frozen) return;
+    pthread_mutex_lock( &profile_mutex );
+    thread->frozen = 0;
+    svcSetThreadActivity( thread->handle, ThreadActivity_Runnable );
+    pthread_mutex_unlock( &profile_mutex );
+}
