diff --git a/horizon-wine/games/deadpool.conf b/horizon-wine/games/deadpool.conf
new file mode 100644
index 00000000..642c551f
--- /dev/null
+++ b/horizon-wine/games/deadpool.conf
@@ -0,0 +1,18 @@
+# Deadpool (2013, High Moon): Unreal Engine 3, 32-bit x86, Direct3D 9,
+# through WoW64 + FEX and DXVK. Read by build-game.sh.
+ROOT_NAME=deadpool
+APP_NAME="Deadpool"
+APP_AUTHOR="Hecho por Ascencion H.O"
+APP_ICON=horizon-wine/assets/deadpool.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Deadpool para Nintendo Switch||Hecho por Ascencion H.O"
+# Copy the game's gamedata folder (Binaries, TransGame) to
+# switch/deadpool/drive_c/Deadpool/gamedata. steam_api.dll in Binaries must
+# start without Steam (check on a PC with Steam closed).
+EXE="Deadpool/gamedata/Binaries/DP.exe"
+# Windowed at 960x540, no intro videos. To change them without rebuilding,
+# put the line in drive_c/Deadpool/gamedata/Binaries/DP.args.txt.
+ARGS="-windowed -ResX=960 -ResY=540 -nostartupmovies"
+# Files copied onto the card as they are, under switch/deadpool: FEX with TSO
+# and DXVK with the FPS counter (DP.wine-nx.txt).
+FILES=horizon-wine/games/deadpool
diff --git a/horizon-wine/games/deadpool/drive_c/Deadpool/gamedata/Binaries/DP.wine-nx.txt b/horizon-wine/games/deadpool/drive_c/Deadpool/gamedata/Binaries/DP.wine-nx.txt
new file mode 100644
index 00000000..4253b840
--- /dev/null
+++ b/horizon-wine/games/deadpool/drive_c/Deadpool/gamedata/Binaries/DP.wine-nx.txt
@@ -0,0 +1,4 @@
+cpu=fex
+d3d=dxvk
+FEX_TSOENABLED=1
+dxvk-hud=fps
diff --git a/horizon-wine/games/left4dead.conf b/horizon-wine/games/left4dead.conf
new file mode 100644
index 00000000..319bcb61
--- /dev/null
+++ b/horizon-wine/games/left4dead.conf
@@ -0,0 +1,18 @@
+# Left 4 Dead (2008): 32-bit x86, through WoW64 + FEX. Read by build-game.sh.
+ROOT_NAME=left4dead
+APP_NAME="Left 4 Dead"
+APP_AUTHOR="Port hecho por Asce22"
+APP_ICON=horizon-wine/assets/left4dead.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Left 4 Dead para Nintendo Switch||Port hecho por Asce22"
+# Copy the whole game folder from Steam to switch/left4dead/drive_c/Left 4 Dead.
+# Steam is Goldberg's steam_api.dll in the game folder and in bin; a d3d9.dll
+# of the game's own in bin must go, or it is used instead of Autorun's DXVK.
+EXE="Left 4 Dead/left4dead.exe"
+# What works on the Switch: windowed at 960x540, no Steam servers, the
+# controller as an Xbox pad (360controller.cfg binds it). To change them
+# without rebuilding, put the line in drive_c/Left 4 Dead/left4dead.args.txt.
+ARGS="-game left4dead -novid -windowed -noborder -w 960 -h 540 -insecure +sv_lan 1 +joystick 1 +exec 360controller"
+# Files copied onto the card as they are, under switch/left4dead: DXVK and FEX
+# with TSO (left4dead.wine-nx.txt), Goldberg without networking, the pad config.
+FILES=horizon-wine/games/left4dead
