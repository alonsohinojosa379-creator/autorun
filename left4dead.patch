From fb6288e2d1f371797c21595bc2642882ebb2d5fe Mon Sep 17 00:00:00 2001
From: Alonso <alonsohinojosa379@gmail.com>
Date: Sat, 3 Oct 2026 12:42:21 -0600
Subject: [PATCH] Single-game builds from game profiles; add Left 4 Dead

- horizon-wine/build-game.sh GAME builds any game in horizon-wine/games/GAME.conf;
  build-theforest.sh now calls it with theforest
- WINE_NX_FIXED_ARGS: the game's command line, built in; NAME.args.txt beside
  the game still wins over it
- The fixed target is checked for the low-address window, as the launcher does
- WINE_NX_BOX64_CODE_MAX_MB sets the Box64 code cap (288 MB by default)
- package-single-game.py --extra copies a game's own files onto the card
- Left 4 Dead profile (32-bit, WoW64 + Box64) with autoexec.cfg,
  steam_appid.txt and a placeholder icon

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CT1jdDFEW2Syqr2RTkfhiB
---
 horizon-wine/CMakeLists.txt                   |   6 ++-
 horizon-wine/assets/left4dead.jpg             | Bin 0 -> 28142 bytes
 horizon-wine/build-amd64-components.sh        |   6 ++-
 horizon-wine/build-game.sh                    |  45 ++++++++++++++++++
 horizon-wine/build-theforest.sh               |  22 +--------
 horizon-wine/games/left4dead.conf             |  13 +++++
 .../Left 4 Dead/left4dead/cfg/autoexec.cfg    |   9 ++++
 .../drive_c/Left 4 Dead/steam_appid.txt       |   1 +
 horizon-wine/games/theforest.conf             |   8 ++++
 horizon-wine/source/runtime.c                 |  16 +++++++
 horizon-wine/source/wow64_box64_dynarec.c     |   5 +-
 horizon-wine/tools/package-single-game.py     |  24 +++++++++-
 12 files changed, 129 insertions(+), 26 deletions(-)
 create mode 100644 horizon-wine/assets/left4dead.jpg
 create mode 100644 horizon-wine/build-game.sh
 create mode 100644 horizon-wine/games/left4dead.conf
 create mode 100644 horizon-wine/games/left4dead/drive_c/Left 4 Dead/left4dead/cfg/autoexec.cfg
 create mode 100644 horizon-wine/games/left4dead/drive_c/Left 4 Dead/steam_appid.txt
 create mode 100644 horizon-wine/games/theforest.conf

diff --git a/horizon-wine/CMakeLists.txt b/horizon-wine/CMakeLists.txt
index 4d9195e..5c12a70 100644
--- a/horizon-wine/CMakeLists.txt
+++ b/horizon-wine/CMakeLists.txt
@@ -11,11 +11,15 @@ set(WINE_NX_APP_AUTHOR "ticoverse.com" CACHE STRING "Author the HOME menu shows"
 set(WINE_NX_APP_VERSION "0.0.1" CACHE STRING "Version the HOME menu shows")
 set(WINE_NX_APP_ICON "${CMAKE_CURRENT_SOURCE_DIR}/assets/autorun.jpg" CACHE FILEPATH "256x256 JPEG icon")
 set(WINE_NX_FIXED_TARGET "" CACHE STRING "sdmc: path of the one program to start, instead of the launcher")
+set(WINE_NX_FIXED_ARGS "" CACHE STRING "Command line after the program's name, unless NAME.args.txt is beside it")
+set(WINE_NX_BOX64_CODE_MAX_MB "288" CACHE STRING "Most memory Box64 may take for translated code, in MB")
+add_compile_definitions("NX_ARENA_TOTAL_MAX_MB=${WINE_NX_BOX64_CODE_MAX_MB}")
 add_compile_definitions("WINE_NX_ROOT_NAME=\"${WINE_NX_ROOT_NAME}\""
                         "WINE_NX_APP_NAME=\"${WINE_NX_APP_NAME}\""
                         "WINE_NX_APP_AUTHOR=\"${WINE_NX_APP_AUTHOR}\"")
 if(WINE_NX_FIXED_TARGET)
-    add_compile_definitions("WINE_NX_FIXED_TARGET=\"${WINE_NX_FIXED_TARGET}\"")
+    add_compile_definitions("WINE_NX_FIXED_TARGET=\"${WINE_NX_FIXED_TARGET}\""
+                            "WINE_NX_FIXED_ARGS=\"${WINE_NX_FIXED_ARGS}\"")
     message(STATUS "Single-game build: ${WINE_NX_APP_NAME} -> ${WINE_NX_FIXED_TARGET}")
 endif()
 if(WINE_NX_BOOT_BUNDLE)
diff --git a/horizon-wine/assets/left4dead.jpg b/horizon-wine/assets/left4dead.jpg
new file mode 100644
