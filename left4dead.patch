+#ifdef WINE_NX_SPLASH
+/* The build's own credits, centred on the console for a few seconds before the
+ * game takes the screen; A, B or + skips them. Lines are split at '|'. */
+static void fixed_target_credits( void )
+{
+    static const char text[] = WINE_NX_SPLASH;
+    const char *line = text;
+    int lines = 1, row, i;
+    PadState pad;
+    u64 start;
+
+    if (!text[0]) return;
+    for (i = 0; text[i]; i++) if (text[i] == '|') lines++;
+    wine_nx_console_quiet = 0;
+    consoleClear();
+    row = (45 - lines * 2) / 2;  /* the console is 80x45 */
+    while (line)
+    {
+        const char *bar = strchr( line, '|' );
+        int len = bar ? (int)(bar - line) : (int)strlen( line ), col = (80 - len) / 2;
+
+        printf( "\x1b[%d;%dH%.*s", row, col < 1 ? 1 : col + 1, len, line );
+        row += 2;
+        line = bar ? bar + 1 : NULL;
+    }
+    consoleUpdate( NULL );
+    log_line( "[FIXED] credits: %s", text );
+    padConfigureInput( 1, HidNpadStyleSet_NpadStandard );
+    padInitializeDefault( &pad );
+    start = armGetSystemTick();
+    while (appletMainLoop() && armTicksToNs( armGetSystemTick() - start ) < 3000000000ull)
+    {
+        padUpdate( &pad );
+        if (padGetButtonsDown( &pad ) & (HidNpadButton_A | HidNpadButton_B | HidNpadButton_Plus)) break;
+        consoleUpdate( NULL );
+        svcSleepThread( 16000000 );
+    }
+    consoleClear();
+    consoleUpdate( NULL );
+    wine_nx_console_quiet = 1;
+}
+#endif
+
 /* Started from the Homebrew Menu rather than from its own HOME icon: offer to
  * make that icon (a 39-bit forwarder, which 64-bit games need). Returns 1 to go
  * on and start the game, 0 to leave. */
@@ -4049,10 +4103,18 @@ int main( int argc, char **argv )
             leave_cleanly();
             return 0;
         }
+#ifdef WINE_NX_SPLASH
+        fixed_target_credits();
+#endif
         snprintf( target, sizeof(target), "%s", WINE_NX_FIXED_TARGET );
         launch_error = NULL;
         if (access( target, R_OK ))
             return fixed_target_stop( "No se encuentra el juego en " WINE_NX_FIXED_TARGET );
+        /* What the launcher checks before it starts a game: an .exe with no
+         * relocations only loads at its own address, in the low window. */
+        if (launcher_program_address_space( target ) == LAUNCHER_ADDRESS_LOW && !low_window_available)
+            return fixed_target_stop( "Este juego necesita el parche de direcciones bajas de Atmosphere.\n"
+                                      "  Instalalo con Quick setup en Autorun y reinicia la consola." );
         forwarded_game = 1;
         log_line( "[FIXED] %s", target );
     }
