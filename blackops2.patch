diff --git a/horizon-wine/games/blackops2.conf b/horizon-wine/games/blackops2.conf
new file mode 100644
index 0000000..143f22a
--- /dev/null
+++ b/horizon-wine/games/blackops2.conf
@@ -0,0 +1,19 @@
+# Call of Duty: Black Ops II, campaign: 32-bit x86 (t6sp.exe), Direct3D 11,
+# through WoW64 + FEX and DXVK. Read by build-game.sh.
+ROOT_NAME=blackops2
+APP_NAME="Call of Duty: Black Ops II"
+APP_AUTHOR="Hecho por Ascencion H.O - Base Dantico"
+APP_ICON=horizon-wine/assets/blackops2.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Call of Duty: Black Ops II para Nintendo Switch||Hecho por Ascencion H.O|Base Dantico"
+# Copy the whole game folder from Steam to
+# switch/blackops2/drive_c/Black Ops II (t6sp.exe, zone, video, sound...).
+# Steam is handled the same way as Left 4 Dead; a d3d11.dll or dxgi.dll of
+# the game's own must go, or it is used instead of Autorun's DXVK.
+EXE="Black Ops II/t6sp.exe"
+# Graphics are set in the game's own options (resolution, textures, shadows).
+# Extra command line without rebuilding: drive_c/Black Ops II/t6sp.args.txt.
+ARGS=""
+# Files copied onto the card as they are, under switch/blackops2: DXVK and
+# FEX with TSO, 30 fps cap and fps counter (t6sp.wine-nx.txt), dxvk.conf.
+FILES=horizon-wine/games/blackops2
diff --git a/horizon-wine/games/blackops2/drive_c/Black Ops II/dxvk.conf b/horizon-wine/games/blackops2/drive_c/Black Ops II/dxvk.conf
new file mode 100644
index 0000000..a085e45
--- /dev/null
+++ b/horizon-wine/games/blackops2/drive_c/Black Ops II/dxvk.conf	
@@ -0,0 +1,3 @@
+# Black Ops II en Switch: 32 bits, poca memoria de direcciones
+d3d11.cachedDynamicResources = a
+dxgi.maxDeviceMemory = 512
diff --git a/horizon-wine/games/blackops2/drive_c/Black Ops II/steam_appid.txt b/horizon-wine/games/blackops2/drive_c/Black Ops II/steam_appid.txt
new file mode 100644
index 0000000..add1deb
--- /dev/null
+++ b/horizon-wine/games/blackops2/drive_c/Black Ops II/steam_appid.txt	
@@ -0,0 +1 @@
+202970
diff --git a/horizon-wine/games/blackops2/drive_c/Black Ops II/steam_settings/disable_networking.txt b/horizon-wine/games/blackops2/drive_c/Black Ops II/steam_settings/disable_networking.txt
new file mode 100644
index 0000000..e69de29
diff --git a/horizon-wine/games/blackops2/drive_c/Black Ops II/t6sp.wine-nx.txt b/horizon-wine/games/blackops2/drive_c/Black Ops II/t6sp.wine-nx.txt
new file mode 100644
index 0000000..6c981c9
--- /dev/null
+++ b/horizon-wine/games/blackops2/drive_c/Black Ops II/t6sp.wine-nx.txt	
@@ -0,0 +1,8 @@
+cpu=fex
+d3d=dxvk
+FEX_TSOENABLED=1
+FEX_MAXINST=5000
+frame-limit=30
+vsync=0
+upscaling=fsr
+dxvk-hud=fps
