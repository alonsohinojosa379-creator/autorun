diff --git a/horizon-wine/games/gtaiv.conf b/horizon-wine/games/gtaiv.conf
new file mode 100644
index 0000000..33f6852
--- /dev/null
+++ b/horizon-wine/games/gtaiv.conf
@@ -0,0 +1,21 @@
+# Grand Theft Auto IV (1.0.7.0): 32-bit x86, through WoW64 + FEX. Read by build-game.sh.
+ROOT_NAME=gtaiv
+APP_NAME="Grand Theft Auto IV"
+APP_AUTHOR="Port de Ascencion H.0"
+APP_ICON=horizon-wine/assets/gtaiv.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Grand Theft Auto IV para Nintendo Switch||Port Hecho por Ascencion H.O"
+# Copy everything inside gta_data to switch/gtaiv/drive_c/GTAIV (GTAIV.exe,
+# common, pc, movies, Profiles...). GFWL is replaced by XLiveLess: the game's
+# own xlive.dll or Autorun's. No d3d9.dll of the game's own may stay in that
+# folder, or it is used instead of Autorun's DXVK.
+EXE="GTAIV/GTAIV.exe"
+# Everything at minimum, windowed at 960x540 like Left 4 Dead. -nomemrestrict
+# and -availablevidmem stop the game from refusing settings over the memory
+# DXVK reports; -noBlockOnLostFocus keeps it running when it loses focus.
+# To change them without rebuilding, put the line in
+# drive_c/GTAIV/GTAIV.args.txt (commandline.txt beside the game adds to it).
+ARGS="-norestrictions -nomemrestrict -availablevidmem 1024 -windowed -width 960 -height 540 -novblank -noBlockOnLostFocus -texturequality 0 -renderquality 0 -shadowdensity 0 -viewdistance 1 -detailquality 1"
+# Files copied onto the card as they are, under switch/gtaiv: DXVK and FEX
+# with TSO, capped at 30 fps (GTAIV.wine-nx.txt).
+FILES=horizon-wine/games/gtaiv
diff --git a/horizon-wine/games/gtaiv/drive_c/GTAIV/GTAIV.wine-nx.txt b/horizon-wine/games/gtaiv/drive_c/GTAIV/GTAIV.wine-nx.txt
new file mode 100644
index 0000000..5059be0
--- /dev/null
+++ b/horizon-wine/games/gtaiv/drive_c/GTAIV/GTAIV.wine-nx.txt
@@ -0,0 +1,4 @@
+cpu=fex
+d3d=dxvk
+FEX_TSOENABLED=1
+frame-limit=30
-- 
2.43.0

