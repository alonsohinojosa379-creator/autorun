+/* A single-game build for an .exe that only loads at a low address: its own
+ * HOME icon takes Autorun's title ID, the only one the Atmosphere low-address
+ * patch serves. The name and icon stay the game's. */
+static int forwarder_is_low_window_own( const char *nro_path, const char *args )
+{
+#ifdef WINE_NX_LOW_WINDOW
+    return nro_path && (!args || !args[0]) && !strcmp( nro_path, WINE_NX_RUNTIME_NRO );
+#else
+    (void)nro_path; (void)args;
+    return 0;
+#endif
+}
