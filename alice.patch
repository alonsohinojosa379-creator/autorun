+/* A 32-bit thread under the emulator only hands its registers to the server when
+ * it calls it. A thread that is suspended while running guest code never does,
+ * and Mono's garbage collector, which suspends every thread and reads its
+ * registers, then hangs or fails with "GetThreadContext failed". Fill in the
+ * i386 context from the best source there is. */
+static void horizon_server_fill_i386_context( struct context_data *context, const struct wine_nx_x86_regs *r )
+{
+    memset( context, 0, sizeof(*context) );
+    context->machine = HORIZON_IMAGE_FILE_MACHINE_I386;
+    context->flags = SERVER_CTX_CONTROL | SERVER_CTX_INTEGER | SERVER_CTX_SEGMENTS;
+    context->ctl.i386_regs.eip = r->eip;
+    context->ctl.i386_regs.ebp = r->ebp;
+    context->ctl.i386_regs.esp = r->esp;
+    context->ctl.i386_regs.eflags = r->eflags;
+    context->ctl.i386_regs.cs = 0x23;
+    context->ctl.i386_regs.ss = 0x2b;
+    context->integer.i386_regs.eax = r->eax;
+    context->integer.i386_regs.ebx = r->ebx;
+    context->integer.i386_regs.ecx = r->ecx;
+    context->integer.i386_regs.edx = r->edx;
+    context->integer.i386_regs.esi = r->esi;
+    context->integer.i386_regs.edi = r->edi;
+    context->seg.i386_regs.ds = 0x2b;
+    context->seg.i386_regs.es = 0x2b;
+    context->seg.i386_regs.fs = 0x53;
+    context->seg.i386_regs.gs = 0x2b;
+}
+
+/* The thread's i386 state as exported at its last system call or unix call: a
+ * thread waiting in the server is stopped at one, so this is its real state. */
+static int horizon_server_cpu_area_regs( const struct horizon_server_object *object, struct wine_nx_x86_regs *r )
+{
+    const TEB *teb = (const TEB *)(ULONG_PTR)object->thread.teb;
+    const unsigned char *cpu, *c;
+
+    if (!teb || !(cpu = teb->TlsSlots[WOW64_TLS_CPURESERVED])) return 0;
+    c = cpu + 4;  /* after WOW64_CPURESERVED; an I386_CONTEXT */
+    r->edi = *(const unsigned int *)(c + 0x9c);
+    r->esi = *(const unsigned int *)(c + 0xa0);
+    r->ebx = *(const unsigned int *)(c + 0xa4);
+    r->edx = *(const unsigned int *)(c + 0xa8);
+    r->ecx = *(const unsigned int *)(c + 0xac);
+    r->eax = *(const unsigned int *)(c + 0xb0);
+    r->ebp = *(const unsigned int *)(c + 0xb4);
+    r->eip = *(const unsigned int *)(c + 0xb8);
+    r->eflags = *(const unsigned int *)(c + 0xc0);
+    r->esp = *(const unsigned int *)(c + 0xc4);
+    return r->esp != 0;
+}
+
+static void horizon_gcfix_trace( const char *fmt, ... )
+{
+    extern void wine_nx_runtime_trace( const char *msg ) __attribute__((weak));
+    static unsigned int count;
+    char buf[200];
+    va_list args;
+
+    if (!&wine_nx_runtime_trace || __atomic_add_fetch( &count, 1, __ATOMIC_RELAXED ) > 64) return;
+    va_start( args, fmt );
+    vsnprintf( buf, sizeof(buf), fmt, args );
+    va_end( args );
+    wine_nx_runtime_trace( buf );
+}
