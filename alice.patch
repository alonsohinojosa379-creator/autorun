diff --git a/horizon-wine/games/alice.conf b/horizon-wine/games/alice.conf
new file mode 100644
index 00000000..fb8a2ec6
--- /dev/null
+++ b/horizon-wine/games/alice.conf
@@ -0,0 +1,23 @@
+# Alice: Madness Returns (2011, Spicy Horse / EA): Unreal Engine 3, 32-bit x86,
+# Direct3D 9, PhysX CPU, through WoW64 + FEX and DXVK. Read by build-game.sh.
+ROOT_NAME=alice
+APP_NAME="Alice Madness Returns"
+APP_AUTHOR="Hecho por Ascencion H.O"
+APP_ICON=horizon-wine/assets/alice.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Alice Madness Returns para Nintendo Switch||Hecho por Ascencion H.O|Fork creado por El Boss Shifu, Lord Erick y Ascencion H.O.|Basado en AutorunNX de Dantico"
+# Copy the contents of the game folder Alice2 (Binaries, AliceGame, Engine, ...) to
+# switch/alice/drive_c/Alice. steam_api.dll (if any) must start without Steam
+# (check on a PC with Steam closed).
+EXE="Alice/Binaries/Win32/AliceMadnessReturns.exe"
+# Windowed at 960x540, no intro videos. To change them without rebuilding,
+# put the line in drive_c/Alice/Binaries/Win32/AliceMadnessReturns.args.txt.
+ARGS="-windowed -ResX=960 -ResY=540 -nostartupmovies"
+# Files copied onto the card as they are, under switch/alice: FEX with TSO
+# and DXVK with the FPS counter (AliceMadnessReturns.wine-nx.txt).
+FILES=horizon-wine/games/alice
+# AliceMadnessReturns.exe has no relocations and only loads at 0x00400000: it
+# needs the Atmosphere low-address patch (Hekate entry "Autorun - direcciones
+# bajas") and its HOME icon takes Autorun's title ID, the only one that patch
+# serves. Only one LOW_WINDOW game can be installed at a time.
+LOW_WINDOW=1
