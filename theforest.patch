From e07bb15da33d7dd4f799b50df5dff7f0962d331e Mon Sep 17 00:00:00 2001
From: Alonso <alonsohinojosa379@gmail.com>
Date: Wed, 30 Sep 2026 13:23:31 -0600
Subject: [PATCH] The Forest edition: single-game build with its own folder,
 name and icon

- WINE_NX_ROOT_NAME moves sdmc:/switch/wine to sdmc:/switch/<name>
- WINE_NX_APP_NAME/AUTHOR/ICON set the HOME menu name and icon
- WINE_NX_FIXED_TARGET starts one game with no launcher, offers to
  install its HOME icon, and returns to HOME on exit
- tools/package-single-game.py builds the card zip with the DLLs in place
- build-theforest.sh builds it all

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xpq6Y5HJQCU7wqc58mHiJA
---
 dlls/ntdll/unix/horizon.c                 |   5 +-
 dlls/ntdll/unix/horizon_runtime_paths.h   |   8 +-
 dlls/ntdll/unix/loader.c                  |  11 +-
 horizon-wine/CMakeLists.txt               |  25 ++++-
 horizon-wine/assets/theforest-splash.jpg  | Bin 0 -> 149994 bytes
 horizon-wine/assets/theforest.jpg         | Bin 0 -> 34097 bytes
 horizon-wine/build-amd64-components.sh    |   8 +-
 horizon-wine/build-theforest.sh           |  21 ++++
 horizon-wine/source/forwarder_launch.h    |   3 +-
 horizon-wine/source/launcher_list.h       |   3 +-
 horizon-wine/source/lsfg.cpp              |   5 +-
 horizon-wine/source/runtime.c             | 116 +++++++++++++++++++++-
 horizon-wine/tools/package-single-game.py |  86 ++++++++++++++++
 13 files changed, 270 insertions(+), 21 deletions(-)
 create mode 100644 horizon-wine/assets/theforest-splash.jpg
 create mode 100644 horizon-wine/assets/theforest.jpg
 create mode 100755 horizon-wine/build-theforest.sh
 create mode 100755 horizon-wine/tools/package-single-game.py

diff --git a/dlls/ntdll/unix/horizon.c b/dlls/ntdll/unix/horizon.c
index e36dbb7..dc75c00 100644
--- a/dlls/ntdll/unix/horizon.c
+++ b/dlls/ntdll/unix/horizon.c
@@ -19,6 +19,7 @@
 
 #ifdef HORIZON_STANDALONE_SYNTAX
 #include "horizon_syntax_shim.h"
+#include "horizon_runtime_paths.h"
 #else
 
 #include <errno.h>
@@ -5635,7 +5636,7 @@ static unsigned int horizon_server_ensure_session_locked(void)
     if (!(horizon_session_data = calloc( 1, HORIZON_SESSION_MAPPING_SIZE )))
         return HORIZON_STATUS_NO_MEMORY;
 
-    snprintf( path, sizeof(path), "sdmc:/switch/wine/wine-nx-session-%u.shm", (unsigned int)getpid() );
+    snprintf( path, sizeof(path), WINE_NX_SHARED_ROOT "/wine-nx-session-%u.shm", (unsigned int)getpid() );
     fd = open( path, O_RDWR | O_CREAT | O_TRUNC, 0600 );
     if (fd == -1)
     {
@@ -13744,7 +13745,7 @@ void horizon_trace( const char *fmt, ... )
     /* Each verbose line reopens the separate trace file on the SD card. */
     if (!&wine_nx_runtime_verbose || !wine_nx_runtime_verbose) return;
     pthread_mutex_lock( &lock );
-    if ((f = fopen( "sdmc:/switch/wine/logs/horizon-trace.log", "a" )))
+    if ((f = fopen( WINE_NX_SHARED_ROOT "/logs/horizon-trace.log", "a" )))
     {
         __builtin_va_start( args, fmt );
         vfprintf( f, fmt, args );
diff --git a/dlls/ntdll/unix/horizon_runtime_paths.h b/dlls/ntdll/unix/horizon_runtime_paths.h
index 02349db..bd6e51e 100644
--- a/dlls/ntdll/unix/horizon_runtime_paths.h
+++ b/dlls/ntdll/unix/horizon_runtime_paths.h
@@ -1,9 +1,13 @@
 #ifndef WINE_NX_HORIZON_RUNTIME_PATHS_H
 #define WINE_NX_HORIZON_RUNTIME_PATHS_H
 
-#define WINE_NX_SHARED_ROOT "sdmc:/switch/wine"
+/* The folder under sdmc:/switch; -DWINE_NX_ROOT_NAME="theforest" moves everything. */
+#ifndef WINE_NX_ROOT_NAME
+#define WINE_NX_ROOT_NAME "wine"
+#endif
+#define WINE_NX_SHARED_ROOT "sdmc:/switch/" WINE_NX_ROOT_NAME
 #define WINE_NX_RUNTIME_ROOT WINE_NX_SHARED_ROOT
-#define WINE_NX_RUNTIME_DOS_ROOT "\\??\\Z:\\switch\\wine"
+#define WINE_NX_RUNTIME_DOS_ROOT "\\??\\Z:\\switch\\" WINE_NX_ROOT_NAME
 #define WINE_NX_RUNTIME_DRIVE_C WINE_NX_RUNTIME_ROOT "/drive_c"
 #define WINE_NX_RUNTIME_WINDOWS WINE_NX_RUNTIME_DRIVE_C "/windows"
 #define WINE_NX_RUNTIME_SYSTEM32 WINE_NX_RUNTIME_WINDOWS "/system32"
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 3426e11..e1b5953 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -105,14 +105,17 @@
 #ifndef SYSTEMDLLPATH
 #define SYSTEMDLLPATH ""
 #endif
+#ifndef WINE_NX_ROOT_NAME
+#define WINE_NX_ROOT_NAME "wine"
+#endif
 #ifndef BINDIR
-#define BINDIR "/switch/wine/bin"
+#define BINDIR "/switch/" WINE_NX_ROOT_NAME "/bin"
 #endif
 #ifndef LIBDIR
-#define LIBDIR "/switch/wine/lib"
+#define LIBDIR "/switch/" WINE_NX_ROOT_NAME "/lib"
 #endif
 #ifndef DATADIR
-#define DATADIR "/switch/wine/share"
+#define DATADIR "/switch/" WINE_NX_ROOT_NAME "/share"
 #endif
 #endif
 
@@ -410,7 +413,7 @@ static void set_home_dir(void)
     const char *p;
 
 #ifdef __SWITCH__
-    if (!home) home = "/switch/wine";
+    if (!home) home = "/switch/" WINE_NX_ROOT_NAME;
     if (!name) name = "wine";
 #else
     if (!home || !name)
diff --git a/horizon-wine/CMakeLists.txt b/horizon-wine/CMakeLists.txt
index d4afd30..4d9195e 100644
--- a/horizon-wine/CMakeLists.txt
+++ b/horizon-wine/CMakeLists.txt
@@ -3,6 +3,21 @@ cmake_minimum_required(VERSION 3.18)
 project(wine_nx_probe LANGUAGES C CXX ASM)
 
 set(WINE_NX_BOOT_BUNDLE "" CACHE PATH "Verified Atmosphere/HOC boot payload bundle")
+
+# A single-game build: its own folder, name and icon, and no launcher.
+set(WINE_NX_ROOT_NAME "wine" CACHE STRING "Folder under sdmc:/switch that holds the runtime and drive_c")
+set(WINE_NX_APP_NAME "Autorun" CACHE STRING "Name the HOME menu and Homebrew Menu show")
+set(WINE_NX_APP_AUTHOR "ticoverse.com" CACHE STRING "Author the HOME menu shows")
+set(WINE_NX_APP_VERSION "0.0.1" CACHE STRING "Version the HOME menu shows")
+set(WINE_NX_APP_ICON "${CMAKE_CURRENT_SOURCE_DIR}/assets/autorun.jpg" CACHE FILEPATH "256x256 JPEG icon")
+set(WINE_NX_FIXED_TARGET "" CACHE STRING "sdmc: path of the one program to start, instead of the launcher")
+add_compile_definitions("WINE_NX_ROOT_NAME=\"${WINE_NX_ROOT_NAME}\""
+                        "WINE_NX_APP_NAME=\"${WINE_NX_APP_NAME}\""
+                        "WINE_NX_APP_AUTHOR=\"${WINE_NX_APP_AUTHOR}\"")
+if(WINE_NX_FIXED_TARGET)
+    add_compile_definitions("WINE_NX_FIXED_TARGET=\"${WINE_NX_FIXED_TARGET}\"")
+    message(STATUS "Single-game build: ${WINE_NX_APP_NAME} -> ${WINE_NX_FIXED_TARGET}")
+endif()
 if(WINE_NX_BOOT_BUNDLE)
     set(WINE_NX_BOOT_ROMFS_FILES "")
     foreach(file setup_boot_manifest.h romfs/setup/loader-stock.kip romfs/setup/loader-hoc.kip
@@ -725,10 +740,10 @@ if(ELF2NSO AND NPDMTOOL)
                 wine_nx_hbl_main "${HBL_NSO}"
                 wine_nx_game_forwarder_main "${GAME_FORWARDER_NSO}"
                 wine_nx_hbl_npdm "${HBL_NPDM}"
-                wine_nx_icon_any "${CMAKE_CURRENT_SOURCE_DIR}/assets/autorun.jpg"
+                wine_nx_icon_any "${WINE_NX_APP_ICON}"
                 wine_nx_logo "${CMAKE_CURRENT_SOURCE_DIR}/assets/logo.png"
         DEPENDS "${HBL_NSO}" "${HBL_NPDM}" "${GAME_FORWARDER_NSO}"
-                "${CMAKE_CURRENT_SOURCE_DIR}/assets/autorun.jpg"
+                "${WINE_NX_APP_ICON}"
                 "${CMAKE_CURRENT_SOURCE_DIR}/assets/logo.png"
                 "${CMAKE_CURRENT_SOURCE_DIR}/tools/make-embed.py"
         VERBATIM
@@ -1110,7 +1125,7 @@ if(NACPTOOL AND ELF2NRO)
 
     add_custom_command(
         OUTPUT "${RUNTIME_NACP_FILE}"
-        COMMAND "${NACPTOOL}" --create "Autorun" "ticoverse.com" "0.0.1" "${RUNTIME_NACP_FILE}"
+        COMMAND "${NACPTOOL}" --create "${WINE_NX_APP_NAME}" "${WINE_NX_APP_AUTHOR}" "${WINE_NX_APP_VERSION}" "${RUNTIME_NACP_FILE}"
         VERBATIM
     )
 
@@ -1121,8 +1136,8 @@ if(NACPTOOL AND ELF2NRO)
     add_custom_command(
         OUTPUT "${RUNTIME_NRO_FILE}"
         COMMAND "${ELF2NRO}" "$<TARGET_FILE:wine-nx-runtime>" "${RUNTIME_NRO_FILE}" "--nacp=${RUNTIME_NACP_FILE}"
-                "--icon=${CMAKE_CURRENT_SOURCE_DIR}/assets/autorun.jpg" ${RUNTIME_ROMFS_ARG}
-        DEPENDS wine-nx-runtime "${RUNTIME_NACP_FILE}" "${CMAKE_CURRENT_SOURCE_DIR}/assets/autorun.jpg"
+                "--icon=${WINE_NX_APP_ICON}" ${RUNTIME_ROMFS_ARG}
+        DEPENDS wine-nx-runtime "${RUNTIME_NACP_FILE}" "${WINE_NX_APP_ICON}"
                 ${WINE_NX_BOOT_ROMFS_FILES}
         VERBATIM
     )
