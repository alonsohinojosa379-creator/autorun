+#!/bin/sh
+# The Forest edition: Autorun built for one game, in sdmc:/switch/theforest,
+# with its own name and icon and no launcher. Run from the repository root,
+# with the same options as build.sh; the card archive is written to
+# horizon-wine/build-autorun/theforest-card.zip.
+set -eu
+root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
+cd "$root"
+
+export WINE_NX_ROOT_NAME="${WINE_NX_ROOT_NAME:-theforest}"
+export WINE_NX_APP_NAME="${WINE_NX_APP_NAME:-The Forest}"
+export WINE_NX_APP_AUTHOR="${WINE_NX_APP_AUTHOR:-Endnight Games}"
+export WINE_NX_APP_ICON="${WINE_NX_APP_ICON:-horizon-wine/assets/theforest.jpg}"
+# Where the game's .exe is on the card; drive_c is the game's C: drive.
+export WINE_NX_FIXED_TARGET="${WINE_NX_FIXED_TARGET:-sdmc:/switch/$WINE_NX_ROOT_NAME/drive_c/The Forest/TheForest.exe}"
+
+sh "$root/build.sh" "$@"
+
+archive="$(ls -t "$root"/horizon-wine/build-autorun/autorun-*.zip | head -n 1)"
+python3 "$root/horizon-wine/tools/package-single-game.py" --autorun "$archive" \
+    --root-name "$WINE_NX_ROOT_NAME" --out "$root/horizon-wine/build-autorun/theforest-card.zip"
