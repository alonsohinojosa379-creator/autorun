         constants.extents[1] = height;
+        if (width > 0 && height > 0)
+        {
+            HWND hwnd = swapchain->surface->hwnd;
+            POINT origin = { 0, 0 };
+
+            client_to_screen( hwnd, &origin );
+            wine_nx_present_map[0] = origin.x;
+            wine_nx_present_map[1] = origin.y;
+            wine_nx_present_map[2] = (swapchain->host_extents.width - width) / 2;
+            wine_nx_present_map[3] = (swapchain->host_extents.height - height) / 2;
+            wine_nx_present_map[4] = swapchain->extents.width / width;
+            wine_nx_present_map[5] = swapchain->extents.height / height;
+            __atomic_store_n( &wine_nx_present_mapped, 1, __ATOMIC_RELEASE );
+        }
     }
