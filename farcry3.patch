diff --git a/horizon-wine/games/farcry3.conf b/horizon-wine/games/farcry3.conf
new file mode 100644
index 00000000..9f86a5b4
--- /dev/null
+++ b/horizon-wine/games/farcry3.conf
@@ -0,0 +1,16 @@
+# Far Cry 3 (PC, copia propia): farcry3.exe, 32 bits, Direct3D 11 por DXVK,
+# WoW64 + FEX. Read by horizon-wine/build-game.sh.
+ROOT_NAME=fc3nx
+APP_NAME="Far Cry 3"
+APP_AUTHOR="Hecho por Ascencion H.O"
+APP_ICON=horizon-wine/assets/farcry3.jpg
+SPLASH="Far Cry 3 para Nintendo Switch||Hecho por Ascencion H.O"
+# Copia la carpeta bin del juego a switch/fc3nx/drive_c/f/b (farcry3.exe y
+# sus DLL) y el resto de la instalacion en switch/fc3nx/drive_c/f (data_win32...).
+EXE="f/b/farcry3.exe"
+# Los argumentos se cambian sin recompilar en drive_c/f/b/farcry3.args.txt.
+ARGS=""
+# Se copian tal cual a la tarjeta: ajustes de FEX/DXVK, args y dxvk.conf.
+FILES=horizon-wine/games/farcry3
+# Es reubicable (relocs), asi que no necesita el parche de direcciones bajas.
+LOW_WINDOW=0
diff --git a/horizon-wine/games/farcry3/drive_c/f/b/dxvk.conf b/horizon-wine/games/farcry3/drive_c/f/b/dxvk.conf
new file mode 100644
index 00000000..5f48af56
--- /dev/null
+++ b/horizon-wine/games/farcry3/drive_c/f/b/dxvk.conf
@@ -0,0 +1,4 @@
+dxvk.numCompilerThreads = 4
+DXVK_ASYNC = 1
+d3d9.textureMemory = 16
+d3d9.samplerAnisotropy = 0
diff --git a/horizon-wine/games/farcry3/drive_c/f/b/farcry3.args.txt b/horizon-wine/games/farcry3/drive_c/f/b/farcry3.args.txt
new file mode 100644
index 00000000..9eba850a
--- /dev/null
+++ b/horizon-wine/games/farcry3/drive_c/f/b/farcry3.args.txt
@@ -0,0 +1 @@
+-skipintro -offline
\ No newline at end of file
diff --git a/horizon-wine/games/farcry3/drive_c/f/b/farcry3.wine-nx.txt b/horizon-wine/games/farcry3/drive_c/f/b/farcry3.wine-nx.txt
new file mode 100644
index 00000000..f95dde16
--- /dev/null
+++ b/horizon-wine/games/farcry3/drive_c/f/b/farcry3.wine-nx.txt
@@ -0,0 +1,13 @@
+cpu=fex
+d3d=dxvk
+FEX_TSOENABLED=1
+FEX_MAXINST=10000
+FEX_MULTIBLOCK=0
+frame-limit=30
+vsync=0
+upscaling=fsr
+dxvk-hud=fps
+WINE_LARGE_ADDRESS_AWARE=1
+STAGING_SHARED_MEMORY=0
+WINEDLLOVERRIDES="xinput1_3=n,b;d3d10=n,b;d3d10core=n,b;d3d11=n,b;dxgi=n,b;dxdiagn=d;uplay_r1_loader=n,b;ubiorbitapi_r2=n,b;ubiorbitapi_r2_loader=n,b;"
