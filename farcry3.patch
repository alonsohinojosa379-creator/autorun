diff --git a/horizon-wine/games/falloutnv.conf b/horizon-wine/games/falloutnv.conf
new file mode 100644
index 00000000..5b2f5e99
--- /dev/null
+++ b/horizon-wine/games/falloutnv.conf
@@ -0,0 +1,23 @@
+# Fallout: New Vegas (2010): 32-bit x86 (FalloutNV.exe), Direct3D 9, through
+# WoW64 + FEX and DXVK. Read by build-game.sh.
+ROOT_NAME=falloutnv
+APP_NAME="Fallout: New Vegas"
+APP_AUTHOR="Hecho por Ascencion H.O"
+APP_ICON=horizon-wine/assets/falloutnv.jpg
+# Shown before the game starts; '|' starts a new line.
+SPLASH="Fallout: New Vegas para Nintendo Switch||Hecho por Ascencion H.O"
+# Copy the whole game folder from Steam to
+# switch/falloutnv/drive_c/Fallout New Vegas (FalloutNV.exe, Data, ...).
+# A d3d9.dll of the game's own (ENB, reshade...) must go, or it is used
+# instead of Autorun's DXVK.
+EXE="Fallout New Vegas/FalloutNV.exe"
+# No extra command line: video options live in the game's own Fallout.ini.
+# Extra arguments without rebuilding: drive_c/Fallout New Vegas/FalloutNV.args.txt.
+ARGS=""
+# Files copied onto the card as they are, under switch/falloutnv: DXVK and
