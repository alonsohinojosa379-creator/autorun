Claude-Session: https://claude.ai/code/session_016vCWYFeSt88D5G1QzjUVsH
---
 horizon-wine/mesosphere/low-window.patch | 29 ++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/horizon-wine/mesosphere/low-window.patch b/horizon-wine/mesosphere/low-window.patch
index 45c052f7..e188fba2 100644
--- a/horizon-wine/mesosphere/low-window.patch
+++ b/horizon-wine/mesosphere/low-window.patch
@@ -130,3 +130,32 @@ index 2764848..92005e6 100644
                          break;
                      AMS_UNREACHABLE_DEFAULT_CASE();
                  }
+diff --git a/libraries/libmesosphere/source/board/nintendo/nx/kern_k_system_control.cpp b/libraries/libmesosphere/source/board/nintendo/nx/kern_k_system_control.cpp
+index bb7581c..e5078f9 100644
+--- a/libraries/libmesosphere/source/board/nintendo/nx/kern_k_system_control.cpp
++++ b/libraries/libmesosphere/source/board/nintendo/nx/kern_k_system_control.cpp
+@@ -313,7 +313,7 @@ namespace ams::kern::board::nintendo::nx {
+     }
+ 
+     bool KSystemControl::Init::ShouldIncreaseThreadResourceLimit() {
+-        return GetKernelConfigurationForInit().Get<smc::KernelConfiguration::IncreaseThreadResourceLimit>();
++        return true;
+     }
+ 
+     size_t KSystemControl::Init::GetApplicationPoolSize() {
+diff --git a/libraries/libmesosphere/source/kern_k_resource_limit.cpp b/libraries/libmesosphere/source/kern_k_resource_limit.cpp
+index 6ed10a7..2385a30 100644
+--- a/libraries/libmesosphere/source/kern_k_resource_limit.cpp
++++ b/libraries/libmesosphere/source/kern_k_resource_limit.cpp
+@@ -105,6 +105,11 @@ namespace ams::kern {
+         KScopedLightLock lk(m_lock);
+         R_UNLESS(m_current_values[which] <= value, svc::ResultInvalidState());
+ 
++        /* Autorun: applications get 192 threads instead of 96 (retail boost value). */
++        if (which == ams::svc::LimitableResource_ThreadCountMax && value == 0x60) {
++            value = 0xC0;
++        }
++
+         m_limit_values[which] = value;
+         m_peak_values[which]  = m_current_values[which];
+ 
-- 
2.43.0


