+ * (wine_nx_pointer_poll): a finger at screen x is at Wine's
+ * map[0] + (x - map[2]) * map[4], and y likewise with map[1], map[3], map[5].
+ * Zero in wine_nx_present_mapped while nothing is scaled. */
+float wine_nx_present_map[6];
+int wine_nx_present_mapped;
+#endif
+
 #if defined(__SWITCH__) && defined(WINE_NX_MESA_SWITCH)
