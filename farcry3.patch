diff --git a/horizon-wine/games/hytale/drive_c/Hytale/install/release/package/game/latest/Client/HytaleClient.wine-nx.txt b/horizon-wine/games/hytale/drive_c/Hytale/install/release/package/game/latest/Client/HytaleClient.wine-nx.txt
new file mode 100644
