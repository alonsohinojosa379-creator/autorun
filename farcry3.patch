+#!/usr/bin/env python3
+"""Turn an Autorun card archive into a single-game one, in its own folder.
+
+Takes the zip package-autorun.py writes and the DLL repository's switch/wine
+tree, and writes one zip whose contents all live in sdmc:/switch/<root-name>,
+with the Windows DLLs already in place: a single-game build has no launcher to
+download them.
+
+    python3 horizon-wine/tools/package-single-game.py \\
+        --autorun build/autorun-NNN.zip --root-name theforest \\
+        --out theforest-card.zip
+
+The runtime inside the archive must have been built with the same
+-DWINE_NX_ROOT_NAME, or it will look for its files in the old folder.
+"""
+import argparse
+import sys
+from pathlib import Path
+from zipfile import ZipFile, ZIP_DEFLATED
+
+root = Path(__file__).resolve().parents[2]
+
+parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+parser.add_argument('--autorun', type=Path, required=True, help="the archive package-autorun.py wrote")
+parser.add_argument('--dlls', type=Path, default=root / 'horizon-dlls/switch/wine',
+                    help="the DLL repository's switch/wine folder")
+parser.add_argument('--root-name', required=True, help='folder under sdmc:/switch, e.g. theforest')
+parser.add_argument('--extra', type=Path,
+                    help='a folder whose files go into switch/<root-name> as they are, '
+                         'e.g. the game\'s config under drive_c')
+parser.add_argument('--out', type=Path, required=True)
+args = parser.parse_args()
+
+name = args.root_name.strip('/')
+if not name or '/' in name or name == 'wine':
+    sys.exit('--root-name must be one folder name other than "wine"')
+if not (args.dlls / 'horizon-dlls/manifest.json').is_file():
+    sys.exit(f'{args.dlls} has no horizon-dlls/manifest.json: fetch the horizon-dlls submodule first')
+
+OLD, NEW = 'switch/wine/', f'switch/{name}/'
+# Launcher-only files: what it preselects or runs on its own.
+SKIP = {'target.txt', 'run-entry.txt', 'vulkan-probe.txt'}
+TEXT = ('.txt', '.json', '.ini', '.cfg', '.conf', '.md')
+
+
+def remap_text(data: bytes) -> bytes:
+    try:
+        text = data.decode('utf-8')
+    except UnicodeDecodeError:
+        return data
+    return text.replace('sdmc:/switch/wine', f'sdmc:/switch/{name}') \
+               .replace('switch\\wine', f'switch\\{name}').encode('utf-8')
+
+
+# A game's own files win over anything of the same name, so they are known first.
+extra = {}
+if args.extra:
+    if not args.extra.is_dir():
+        sys.exit(f'--extra {args.extra} is not a folder')
+    for path in sorted(args.extra.rglob('*')):
+        if path.is_file():
+            extra[NEW + path.relative_to(args.extra).as_posix()] = path
+extra_count = len(extra)
+
+written = set()
+with ZipFile(args.out, 'w', ZIP_DEFLATED) as out:
+    # The runtime and its files first, so they win over anything of the same name.
+    with ZipFile(args.autorun) as z:
+        for info in z.infolist():
+            if info.is_dir():
+                continue
+            if not info.filename.startswith(OLD):
+                print(f'kept as is (outside switch/wine): {info.filename}')
+                dest = info.filename
+            else:
+                rel = info.filename[len(OLD):]
+                if rel in SKIP:
+                    continue
+                dest = NEW + rel
+            if dest in extra:
+                print(f'replaced by --extra: {dest}')
+                continue
+            data = z.read(info)
+            if dest.lower().endswith(TEXT):
+                data = remap_text(data)
+            out.writestr(dest, data)
+            written.add(dest)
+    dll_count = 0
+    for path in sorted(args.dlls.rglob('*')):
+        if not path.is_file():
+            continue
+        dest = NEW + path.relative_to(args.dlls).as_posix()
+        if dest in written or dest in extra:
+            continue
+        out.write(path, dest)
+        written.add(dest)
+        dll_count += 1
+    for dest, path in extra.items():
+        out.write(path, dest)
+        written.add(dest)
+
+nro = NEW + 'wine-nx-runtime.nro'
+if nro not in written:
+    sys.exit(f'{nro} is missing: is {args.autorun} a card archive?')
+print(f'{args.out}: {len(written)} files ({dll_count} from the DLL repository, '
+      f'{extra_count} of the game\'s own) in sdmc:/{NEW}')
-- 
