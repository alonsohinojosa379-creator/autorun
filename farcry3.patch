index 00000000..26672d4a
--- /dev/null
+++ b/horizon-wine/games/minecraft.conf
@@ -0,0 +1,18 @@
+# Minecraft Java 1.12.2 + OptiFine: se abre javaw.exe (Java 8 de 64 bits) directo
+# con los argumentos del juego, sin el minecraft.exe (el launcher). OpenGL por
+# Mesa (LWJGL 2). Read by horizon-wine/build-game.sh. EXPERIMENTAL: la Switch da
+# unos 3 GB a los homebrew y Java corre emulado.
+ROOT_NAME=minecraft
+APP_NAME="Minecraft"
+APP_AUTHOR="Hecho por Ascencion H.O"
+APP_ICON=horizon-wine/assets/minecraft.jpg
+SPLASH="Minecraft para Nintendo Switch||Hecho por Ascencion H.O"
+# Copia tu carpeta mcdata (la que esta junto a minecraft.exe) a
+# switch/minecraft/drive_c/mcdata. Tiene que traer runtime/j64_u8 (Java 8 de 64
+# bits), libraries, versions/1.12.2/1.12.2.jar y assets.
+EXE="mcdata/runtime/j64_u8/bin/javaw.exe"
+# Las opciones de Java van en javaw.args.txt, junto a javaw.exe (se cambian sin
+# recompilar). La lista de librerias esta en mcdata/mc-cp.jar (su manifest).
+ARGS=""
+FILES=horizon-wine/games/minecraft
+SWAP_POC=1
