Subject: Hytale: anota las llamadas del sistema que responden 'no
 implementado' (diagnostico del Invalid function)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016vCWYFeSt88D5G1QzjUVsH
---
 dlls/ntdll/unix/signal_arm64.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index fa6d06c7..09a312d4 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -648,6 +648,23 @@ ULONG_PTR wine_nx_do_syscall( ULONG_PTR *stack_args,
                                            a8,a9,a10,a11,a12,a13,a14,a15);
     }
 
+    /* diagnostico: anota (aunque no haya verbose) las llamadas que responden
+     * "no implementado" con sus primeros argumentos; la clase suele ir en x1 */
+    if ((unsigned)result == 0xC0000002 && syscall_id < 0x200)
+    {
+        static unsigned int notimpl_seen[0x200];
+        if (notimpl_seen[syscall_id] < 6)
+        {
+            char buf[200];
+            notimpl_seen[syscall_id]++;
+            snprintf( buf, sizeof(buf), "[NOTIMPL] id=0x%04x x0=%llx x1=%llx x2=%llx x3=%llx x5=%llx tid=%04x",
+                      syscall_id, (unsigned long long)x0, (unsigned long long)x1,
+                      (unsigned long long)x2, (unsigned long long)x3, (unsigned long long)x5,
+                      (unsigned)HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ) );
+            wine_nx_runtime_trace( buf );
+        }
+    }
+
     if (trace_syscall)
     {
         char buf[128];
