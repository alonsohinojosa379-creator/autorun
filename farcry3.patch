From 16bfa82f986429f1a905c8e95478bfa87c0339cb Mon Sep 17 00:00:00 2001
From: b <b@l>
Date: Fri, 23 Oct 2026 16:00:22 -0600
Subject: re2: el swap reutiliza el escaneo exacto del heap por 300 ms en vez
 de repetirlo cada vez

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016vCWYFeSt88D5G1QzjUVsH
---
 dlls/ntdll/unix/horizon.c | 48 ++++++++++++++++++++++++++++-----------
 1 file changed, 35 insertions(+), 13 deletions(-)

diff --git a/dlls/ntdll/unix/horizon.c b/dlls/ntdll/unix/horizon.c
index 72aec943..9cb55567 100644
--- a/dlls/ntdll/unix/horizon.c
+++ b/dlls/ntdll/unix/horizon.c
@@ -17741,19 +17741,41 @@ static void swap_pressure_locked( size_t size )
                             &swap_profile.pressure_cached, 1, __ATOMIC_RELAXED );
         return;
     }
-    tick = armGetSystemTick();
-    available = wine_nx_native_heap_free_exact();
-    tick = armGetSystemTick() - tick;
-    __atomic_add_fetch( &swap_profile.pressure_scans, 1, __ATOMIC_RELAXED );
-    __atomic_add_fetch( &swap_profile.pressure_scan_ticks, tick, __ATOMIC_RELAXED );
-    swap_profile_max( &swap_profile.pressure_scan_max_ticks, tick );
-    if (available < target)
-    {
-        __atomic_add_fetch( &swap_profile.pressure, 1, __ATOMIC_RELAXED );
-        trimmed = horizon_pages_trim( &backing_pages );
-        __atomic_add_fetch( &swap_profile.native_trim_bytes, trimmed, __ATOMIC_RELAXED );
-        if (trimmed < target - available)
-            swap_reclaim_locked( min( target - available - trimmed, 64 * UINT64_C(1048576) ) );
+    /* The exact heap scan costs ~85 ms; reuse a recent result and account
+     * for what was allocated since instead of scanning on every call. */
+    {
+        static u64 scan_tick;
+        static size_t scan_avail, scan_debt;
+        u64 now = armGetSystemTick();
+        int fresh = scan_tick && armTicksToNs( now - scan_tick ) < 300000000ULL;
+        if (fresh)
+        {
+            scan_debt += size;
+            available = scan_avail > scan_debt ? scan_avail - scan_debt : 0;
+        }
+        else
+        {
+            tick = now;
+            available = wine_nx_native_heap_free_exact();
+            tick = armGetSystemTick() - tick;
+            __atomic_add_fetch( &swap_profile.pressure_scans, 1, __ATOMIC_RELAXED );
+            __atomic_add_fetch( &swap_profile.pressure_scan_ticks, tick, __ATOMIC_RELAXED );
+            swap_profile_max( &swap_profile.pressure_scan_max_ticks, tick );
+            scan_tick = armGetSystemTick();
+            scan_avail = available;
+            scan_debt = 0;
+        }
+        if (available < target)
+        {
+            size_t got;
+            __atomic_add_fetch( &swap_profile.pressure, 1, __ATOMIC_RELAXED );
+            trimmed = horizon_pages_trim( &backing_pages );
+            __atomic_add_fetch( &swap_profile.native_trim_bytes, trimmed, __ATOMIC_RELAXED );
+            got = trimmed;
+            if (trimmed < target - available)
+                got += swap_reclaim_locked( min( target - available - trimmed, 64 * UINT64_C(1048576) ) );
+            scan_avail += got;
+        }
     }
 }
 
-- 
