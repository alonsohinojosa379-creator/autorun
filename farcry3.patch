+# Controles de Minecraft (codigos de teclas de Windows).
+# Stick izquierdo: caminar (W A S D). Stick derecho: mirar (mueve el raton).
+LSTICK=keys
+LUP=0x57
+LDOWN=0x53
+LLEFT=0x41
+LRIGHT=0x44
+RSTICK=mouse
+# A = clic izquierdo (romper, atacar); B = clic derecho (usar, poner).
+A=0
+B=0
+# X salta, Y abre el inventario, + es Escape (menu).
+X=0x20
+Y=0x45
+PLUS=0x1b
+# Pulsar el stick izquierdo = correr (Ctrl); el derecho = agacharse (Mayus).
+STICKL=0x11
+STICKR=0x10
+# Barra de objetos: casillas 1 a 9.
+UP=0x31
+RIGHT=0x32
+DOWN=0x33
+LEFT=0x34
+L=0x35
+R=0x36
+ZL=0x37
+ZR=0x38
+MINUS=0x39
