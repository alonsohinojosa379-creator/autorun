+    -e NX_FIXED_TARGET="${WINE_NX_FIXED_TARGET:-}" -e NX_FIXED_ARGS="${WINE_NX_FIXED_ARGS:-}" -e NX_SPLASH="${WINE_NX_SPLASH:-}" \
