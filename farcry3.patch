diff --git a/horizon-wine/games/hytale.conf b/horizon-wine/games/hytale.conf
new file mode 100644
index 00000000..96873765
--- /dev/null
+++ b/horizon-wine/games/hytale.conf
@@ -0,0 +1,15 @@
+# Hytale (Early Access): se abre el cliente directo (HytaleClient.exe, 64 bits),
+# sin el launcher, que es de 32 bits y no puede lanzar un exe de 64 bits aqui.
+# Read by horizon-wine/build-game.sh. EXPERIMENTAL: el juego pide 8 GB de RAM en
+# PC y la Switch da unos 3 GB a los homebrew.
+ROOT_NAME=hytale
+APP_NAME="Hytale"
+APP_AUTHOR="Hecho por Ascencion H.O"
+APP_ICON=horizon-wine/assets/hytale.jpg
+SPLASH="Hytale para Nintendo Switch||Hecho por Ascencion H.O"
+# Copia toda la carpeta Hytale de tu PC a switch/hytale/drive_c/Hytale
+EXE="Hytale/install/release/package/game/latest/Client/HytaleClient.exe"
+# Las opciones van en HytaleClient.args.txt, junto al exe (se pueden cambiar sin recompilar).
+ARGS=""
+FILES=horizon-wine/games/hytale
+SWAP_POC=1
diff --git a/horizon-wine/games/hytale/drive_c/Hytale/install/release/package/game/latest/Client/HytaleClient.args.txt b/horizon-wine/games/hytale/drive_c/Hytale/install/release/package/game/latest/Client/HytaleClient.args.txt
